{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (default)" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(기본값)"
          }
        }
      }
    },
    "%@ Camera" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 카메라"
          }
        }
      }
    },
    "%@ GB free of %@ GB" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ GB free of %2$@ GB"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@GB 중 %1$@GB 사용 가능"
          }
        }
      }
    },
    "%@ Is Paused" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱이 일시 정지됐어요"
          }
        }
      }
    },
    "%@ Was Closed" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱이 닫혔어요"
          }
        }
      }
    },
    "%@ can't receive files from this Mac." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱은 이 Mac에서 파일을 받을 수 없어요."
          }
        }
      }
    },
    "%@ can't show %@ while it's folded." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ can't show %2$@ while it's folded."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서는 접힌 상태로 %2$@ 화면을 표시할 수 없어요."
          }
        }
      }
    },
    "%@ couldn't open %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't open %2$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 %2$@ 화면을 열지 못했어요."
          }
        }
      }
    },
    "%@ couldn't open the notification." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 알림을 열지 못했어요."
          }
        }
      }
    },
    "%@ didn't answer in time. Keep it nearby and unlocked, then connect again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 제시간에 응답하지 않았어요. 휴대폰을 가까이 두고 잠금을 해제한 다음 다시 연결해 주세요."
          }
        }
      }
    },
    "%@ doesn't have enough memory to share its notifications." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 알림을 공유할 메모리가 부족해요."
          }
        }
      }
    },
    "%@ doesn't open its apps on this Mac." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 있는 앱은 이 Mac에서 열 수 없어요."
          }
        }
      }
    },
    "%@ doesn't share its notifications with Phone Link." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 Phone Link로 알림을 공유하지 않아요."
          }
        }
      }
    },
    "%@ doesn't share its screen over a metered connection. Connect it to Wi-Fi, then try again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서는 데이터 통신 연결로 화면을 공유하지 않아요. 휴대폰을 Wi-Fi에 연결한 다음 다시 시도해 주세요."
          }
        }
      }
    },
    "%@ is locked." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 화면이 잠겨 있어요."
          }
        }
      }
    },
    "%@ is locked. Unlock it to continue." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 화면이 잠겨 있어요. 계속하려면 잠금을 해제해 주세요."
          }
        }
      }
    },
    "%@ is no longer used as a camera. Only one phone can be a camera at a time." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 %@ 카메라는 사용하지 않아요. 카메라로는 한 번에 휴대폰 한 대만 쓸 수 있어요."
          }
        }
      }
    },
    "%@ is showing something that can't be shown on this Mac." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 이 Mac에서 표시할 수 없는 내용이 나타나 있어요."
          }
        }
      }
    },
    "%@ isn't available on %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ isn't available on %2$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에서 %1$@ 앱을 사용할 수 없어요."
          }
        }
      }
    },
    "%@ isn't on the same network as this Mac. Verify with a code from your phone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 연결된 네트워크가 이 Mac과 달라요. 휴대폰에 표시된 코드로 확인해 주세요."
          }
        }
      }
    },
    "%@ joined the conversation" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 대화에 참여했어요"
          }
        }
      }
    },
    "%@ left the conversation" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 님이 대화에서 나갔어요"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Transfer progress, e.g. 12 of 20 MB",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@"
          }
        }
      }
    },
    "%@ opens in this window where you left off on %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ opens in this window where you left off on %2$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 앱이 %2$@에서 하던 작업 그대로 이 윈도우에서 열려요."
          }
        }
      }
    },
    "%@ paused %@ to open other apps." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ paused %2$@ to open other apps."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 다른 앱을 열려고 %2$@ 앱을 일시 정지했어요."
          }
        }
      }
    },
    "%@ restarts %@ in this window." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ restarts %2$@ in this window."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 %2$@ 앱을 이 윈도우에서 다시 시작해요."
          }
        }
      }
    },
    "%@ restarts on %@ in the new layout." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ restarts on %2$@ in the new layout."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@에서 %1$@ 앱이 새 레이아웃으로 다시 시작돼요."
          }
        }
      }
    },
    "%@ stopped sharing its contacts. Allow access on the phone to see them again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 연락처 공유를 중단했어요. 다시 보려면 휴대폰에서 접근을 허용해 주세요."
          }
        }
      }
    },
    "%@ wants to confirm that you're touching %@. It may behave differently when you use it from this Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ wants to confirm that you're touching %2$@. It may behave differently when you use it from this Mac."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 앱에서 %2$@ 화면을 직접 터치하고 있는지 확인하려고 해요. 이 Mac에서 사용하면 앱이 다르게 동작할 수 있어요."
          }
        }
      }
    },
    "%@ was closed on %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was closed on %2$@."
