    },
    "Your phone didn't answer. Allow instant hotspot in the notification on your phone, then try again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이 응답하지 않았어요. 휴대폰 알림에서 인스턴트 핫스팟을 허용한 다음 다시 시도해 주세요."
          }
        }
      }
    },
    "Your phone didn't answer. Make sure it's nearby and connected, then try again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이 응답하지 않았어요. 휴대폰이 가까이 있고 연결되어 있는지 확인한 다음 다시 시도해 주세요."
          }
        }
      }
    },
    "Your phone didn't become visible over Bluetooth. Keep it nearby and try again." : {
