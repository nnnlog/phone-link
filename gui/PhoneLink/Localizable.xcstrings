    },
    "%@. The PC will be removed from your Microsoft account and can't reach your phone until it's linked again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. 이 PC는 Microsoft 계정에서 제거되고, 다시 연결할 때까지 휴대폰에 연결할 수 없어요."
