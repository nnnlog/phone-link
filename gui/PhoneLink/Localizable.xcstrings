          }
        }
      }
    },
    "You have version %@. Phone Link can't replace itself in %@. Move it to Applications, or download the update from its release page." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have version %1$@. Phone Link can't replace itself in %2$@. Move it to Applications, or download the update from its release page."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 버전은 %1$@입니다. Phone Link가 %2$@에서 자신을 교체할 수 없습니다. 응용 프로그램 폴더로 옮기거나 릴리스 페이지에서 업데이트를 다운로드하세요."
          }
        }
      }
    },
    "You have version %@. Phone Link relaunches after installing it, which briefly disconnects your phone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 버전은 %@입니다. 설치 후 Phone Link가 다시 시작되며, 그동안 휴대폰 연결이 잠시 끊어집니다."
          }
        }
      }
    },
    "You have version %@. This copy of Phone Link wasn't signed by its developer, so it can't check and install the update itself. Download it from its release page." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 버전은 %@입니다. 이 Phone Link는 개발자 서명이 없어 업데이트를 직접 검사하고 설치할 수 없습니다. 릴리스 페이지에서 다운로드하세요."
          }
        }
      }
    },
